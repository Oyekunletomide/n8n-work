      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.replicate.com/v1/predictions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "=stable-video-diffusion-img2vid-xt-1-1"
            },
            {
              "name": "input",
              "value": "={{ {\n  \"input_image\": $json.modelAvatarUrl,\n  \"end_image\": $json.productImageUrl,\n  \"prompt\": $json.videoPrompt,\n  \"motion_bucket_id\": 127,\n  \"fps\": 24,\n  \"num_frames\": 60,\n  \"cond_aug\": 0.02\n} }}"
            }
          ]
        },
        "options": {}
      },
      "id": "start-video-generation",
      "name": "Start Video Generation (Replicate)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [690, 300],
      "notes": "Initiates video generation using Replicate API with Stable Video Diffusion model"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "prediction-id",
              "name": "predictionId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "get-url",
              "name": "getUrl",
              "value": "={{ $json.urls.get }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-prediction",
      "name": "Extract Prediction Info",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [910, 300]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "wait-before-poll",
      "name": "Wait Before Polling",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1130, 300],
      "notes": "Wait 3 seconds before checking status"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.getUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-status",
      "name": "Check Generation Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-succeeded",
              "leftValue": "={{ $json.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-if-complete",
      "name": "Check If Complete",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1570, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-failed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-if-failed",
      "name": "Check If Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1130, 520]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "video-url",
              "name": "videoUrl",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "status-final",
              "name": "status",
              "value": "succeeded",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Video generated successfully!",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-success-response",
      "name": "Format Success Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1790, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "error-message",
              "name": "error",
              "value": "={{ $json.error || 'Video generation failed' }}",
              "type": "string"
            },
            {
              "id": "status-error",
              "name": "status",
              "value": "failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-error-response",
      "name": "Format Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1350, 640]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "webhook-response",
      "name": "Send Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2010, 300]
    },
    {
      "parameters": {
        "jsCode": "// Loop back to check status again\nreturn $input.all();"
      },
      "id": "loop-back",
      "name": "Loop Back to Wait",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 520],
      "notes": "Continue polling if not complete and not failed"
    }
